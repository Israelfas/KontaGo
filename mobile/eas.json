{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.2"
    },
    "prueba": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "produccion": {
      "extends": "base",
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "play-store": {
      "extends": "produccion",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
