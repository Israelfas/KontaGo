# Copiar a .env y completar. Todas las EXPO_PUBLIC_* quedan dentro de la
# app (cualquiera puede leerlas): nunca poner acá claves secretas.

# Clerk (login con Google). La "publishable key", no la secreta.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Dirección del backend. Vacío en desarrollo: se usa la IP de la PC que
# corre Expo, puerto 3000. En producción, ej. https://api.kontago.ec
EXPO_PUBLIC_API_URL=

# Contacto que se muestra en Perfil → Contacto y soporte. Si quedan los
# dos vacíos, esa opción no aparece.
EXPO_PUBLIC_SOPORTE_CORREO=
# Con código de país, ej. +593991234567
EXPO_PUBLIC_SOPORTE_WHATSAPP=

# Mostrar Perfil → Suscripción. Dejar vacío mientras no se cobre.
EXPO_PUBLIC_MOSTRAR_SUSCRIPCION=
