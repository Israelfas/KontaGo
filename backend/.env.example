# App
NODE_ENV=development
PORT=3000
TZ=America/Guayaquil
# Cantidad de proxies delante del backend en producción (Nginx, Railway,
# Render, Cloudflare...), o las direcciones de esos proxies. Vacío en local.
# Ej: detrás de un solo Nginx = 1. En Railway: 100.0.0.0/8, uniquelocal
# (sus proxies internos y la web, que reenvía /api). Nunca "true" (ver
# configuration.ts).
TRUST_PROXY=
# Direcciones de la web que pueden usar la API, separadas por coma.
# Vacío en local (acepta cualquiera); obligatoria en producción.
# Ej: CORS_ORIGINS=https://app.kontago.ec
# Dirección de la web, para los enlaces de los emails (recuperar la
# contraseña). Vacío = la primera de CORS_ORIGINS (o http://localhost:3001 en local).
APP_WEB_URL=
CORS_ORIGINS=
# Ruta de la cookie de sesión de la web, como la ve el navegador. Vacío =
# /auth. Si la web llega al backend por su reenvío de /api (Railway):
# /api/auth.
COOKIE_SESION_RUTA=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=kontago
DB_PASSWORD=kontago
DB_NAME=kontago
DB_SYNCHRONIZE=false
# Base que usan los tests e2e (npm run test:e2e). Se BORRA y se vuelve
# a crear en cada corrida: nunca poner la de desarrollo ni la de producción.
DB_NAME_TEST=kontago_test

# Redis (cache + colas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Cifra en la base los secretos de la verificación en dos pasos. Obligatoria
# en producción (larga y al azar). Si se cambia, quien tenga la
# verificación activada tiene que volver a activarla.
CLAVE_CIFRADO=change-me-clave-de-cifrado

# Correo (recuperar la contraseña y el aviso diario de las 8am, hora Ecuador).
# Dos caminos; si no hay ninguno, el correo no se envía y solo se registra en
# el log — no rompe el backend.
# - BREVO_API_KEY: la API HTTPS de Brevo (brevo.com, 300 correos al día
#   gratis). Es la que sirve en Railway, que bloquea SMTP fuera del plan Pro.
#   El remitente tiene que estar verificado en Brevo.
# - SMTP_*: cualquier proveedor SMTP estándar (Gmail con contraseña de app,
#   Resend, SendGrid, Mailgun, etc).
CORREO_REMITENTE=KontaGo <no-reply@kontago.local>
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Días de anticipación para alertar productos por vencer (pantalla de
# alertas y correo diario usan el mismo valor por defecto)
ALERTAS_DIAS_VENCIMIENTO=7

# Tarifa general de IVA vigente en Ecuador (%). Cambia por decreto
# ejecutivo periódicamente — revisar sri.gob.ec antes de modificar.
IVA_TARIFA_GENERAL=15

# Clerk (login con Google): la clave secreta del panel de Clerk. Vacía =
# el login con Google queda deshabilitado (el de email y contraseña sigue).
CLERK_SECRET_KEY=

# Pruebas e2e de la web: sube el límite de intentos por IP en /auth (solo
# sube, y se ignora en producción). Vacía = el límite normal (10 por minuto).
LIMITE_INTENTOS_AUTH=
