# App
NODE_ENV=development
PORT=3000
TZ=America/Guayaquil

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=kontago
DB_PASSWORD=kontago
DB_NAME=kontago
DB_SYNCHRONIZE=false

# Redis (cache + colas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (correo de notificaciones de vencimiento, corre a las 8am hora Ecuador)
# Cualquier proveedor SMTP estándar sirve (Gmail con contraseña de app,
# Resend, SendGrid, Mailgun, etc). Si SMTP_HOST queda vacío, el correo
# no se envía y solo se registra en el log — no rompe el backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KontaGo <no-reply@kontago.local>

# Días de anticipación para alertar productos por vencer (pantalla de
# alertas y correo diario usan el mismo valor por defecto)
ALERTAS_DIAS_VENCIMIENTO=7
